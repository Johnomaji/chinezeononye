# Copy to .env.local and fill in. .env.local is gitignored, so these must also be
# set in the hosting provider's environment for production.

# Admin panel login (/admin)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Secret used to sign admin session tokens. Use a long random string (32+ chars).
JWT_SECRET=

# Mailchimp, for the newsletter signup
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_API_SERVER=

# Canonical site origin, no trailing slash. Drives canonical URLs, og:url,
# sitemap.xml and robots.txt. Must be the real domain in production, otherwise
# the sitemap ships unreachable URLs.
NEXT_PUBLIC_SITE_URL=https://www.chinezeononye.com
